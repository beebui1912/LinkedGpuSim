#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version resource (so Explorer shows a nice Properties dialog).
//
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Diligent Graphics LLC"
            VALUE "FileDescription",  "Diligent GPU Simulation Launcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SimulationLauncher"
            VALUE "OriginalFilename", "SimulationLauncher.exe"
            VALUE "ProductName",      "DiligentGpuSimulation"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Main launcher dialog.
//
IDD_LAUNCHER DIALOGEX 0, 0, 420, 268
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Diligent GPU Simulation Launcher"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // --- Host GPU ---------------------------------------------------------
    LTEXT           "Host GPU (base adapter for the simulated linked group):",
                    IDC_STATIC_GPU,          10,  10, 400,   9
    COMBOBOX        IDC_COMBO_GPU,           10,  22, 400, 200,
                    CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    // --- Simulated node count ---------------------------------------------
    LTEXT           "Simulated linked nodes:",
                    IDC_STATIC_NODES,        10,  48, 100,   9
    COMBOBOX        IDC_COMBO_NODES,        120,  46,  60,  90,
                    CBS_DROPDOWNLIST | WS_TABSTOP

    // --- Child executable -------------------------------------------------
    LTEXT           "Child executable:",
                    IDC_STATIC_EXE,          10,  72, 400,   9
    EDITTEXT        IDC_EDIT_EXE,            10,  84, 340,  14,
                    ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...",
                    IDC_BUTTON_BROWSE,      355,  84,  55,  14

    // --- Extra child args -------------------------------------------------
    LTEXT           "Arguments passed to the child (e.g.  --mode D3D12  for Diligent samples):",
                    IDC_STATIC_ARGS,         10, 108, 400,   9
    EDITTEXT        IDC_EDIT_ARGS,           10, 120, 400,  14,
                    ES_AUTOHSCROLL | WS_TABSTOP

    // --- Log file ---------------------------------------------------------
    LTEXT           "Log file (empty = default '<launcher>\\SimulationApp.log'):",
                    IDC_STATIC_LOG,          10, 144, 400,   9
    EDITTEXT        IDC_EDIT_LOG,            10, 156, 400,  14,
                    ES_AUTOHSCROLL | WS_TABSTOP

    // --- Feature toggles --------------------------------------------------
    AUTOCHECKBOX    "Inject driver-level shim (D3D12Sim.dll) - required for Tutorial31 to see the linked group",
                    IDC_CHECK_SHIM,          10, 180, 400,  10,
                    WS_TABSTOP
    AUTOCHECKBOX    "Capture OutputDebugString from the child (DebugView-style)",
                    IDC_CHECK_DBGCAPTURE,    10, 194, 400,  10,
                    WS_TABSTOP
    AUTOCHECKBOX    "Verbose shim tracing (log every hooked call)",
                    IDC_CHECK_VERBOSE,       10, 208, 400,  10,
                    WS_TABSTOP

    // --- Status line ------------------------------------------------------
    LTEXT           "",
                    IDC_STATIC_STATUS,       10, 224, 400,  16

    // --- Buttons ----------------------------------------------------------
    DEFPUSHBUTTON   "Launch",
                    IDOK,                   285, 246,  60,  16
    PUSHBUTTON      "Close",
                    IDCANCEL,               350, 246,  60,  16
END
